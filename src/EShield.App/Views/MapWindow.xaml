<Window x:Class="EShield.Views.MapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        Width="540"
        Background="{StaticResource BgBrush}"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">

  <Border Background="{StaticResource BgBrush}"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="1,0,0,0">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40"/>   <!-- title bar -->
        <RowDefinition Height="*"/>    <!-- map -->
        <RowDefinition Height="Auto"/> <!-- status bar -->
      </Grid.RowDefinitions>

      <!-- Title bar -->
      <Grid Grid.Row="0" Background="{StaticResource BgBrush}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
          <TextBlock Text="🗺" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
          <TextBlock Text="Connection Map" FontSize="13" FontWeight="SemiBold"
                     Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"
                    VerticalAlignment="Center" Margin="0,0,8,0">
          <Button Style="{StaticResource GhostButton}" Content="🔄" Width="28" Height="28"
                  Padding="0" FontSize="13" Click="Refresh_Click" ToolTip="Refresh"
                  Margin="0,0,4,0"/>
          <Button Style="{StaticResource GhostButton}" Content="×" Width="28" Height="28"
                  Padding="0" FontSize="16" Click="ClosePanel_Click" ToolTip="Close map"/>
        </StackPanel>
      </Grid>

      <!-- WebView2 map -->
      <wv2:WebView2 x:Name="MapView" Grid.Row="1"
                    DefaultBackgroundColor="Transparent"/>

      <!-- Status bar -->
      <Border Grid.Row="2" Padding="14,6" Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="SubtitleText" Text="Initializing…"
                     FontSize="10.5" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
          <TextBlock x:Name="CountText" Grid.Column="1" FontSize="10.5"
                     Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
