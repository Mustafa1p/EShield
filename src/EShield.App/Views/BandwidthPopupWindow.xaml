<Window x:Class="EShield.Views.BandwidthPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:EShield.Controls"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        Width="380" Height="440"
        Background="{StaticResource BgBrush}"
        ShowInTaskbar="False"
        Topmost="True">

  <Border Background="{StaticResource BgBrush}"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="1" CornerRadius="10">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>  <!-- header -->
        <RowDefinition Height="Auto"/>  <!-- speed -->
        <RowDefinition Height="Auto"/>  <!-- tabs -->
        <RowDefinition Height="Auto"/>  <!-- totals -->
        <RowDefinition Height="*"/>     <!-- chart -->
        <RowDefinition Height="Auto"/>  <!-- destinations -->
      </Grid.RowDefinitions>

      <!-- Header -->
      <Grid Grid.Row="0" Margin="14,12,14,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="42"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                Background="{StaticResource Surface2Brush}" VerticalAlignment="Center">
          <Image x:Name="AppIconImg" Stretch="UniformToFill"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
          <TextBlock x:Name="AppNameText" FontSize="14" FontWeight="SemiBold"
                     Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="AppPathText" FontSize="10.5" Foreground="{StaticResource TextDimBrush}"
                     TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
        </StackPanel>
        <Button Grid.Column="2" Style="{StaticResource GhostButton}"
                Content="×" FontSize="16" Width="28" Height="28" Padding="0"
                Click="Close_Click" VerticalAlignment="Top"/>
      </Grid>

      <!-- Live speed -->
      <Border Grid.Row="1" Margin="14,0,14,8" Background="{StaticResource SurfaceBrush}"
              CornerRadius="6" Padding="10,6">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <TextBlock x:Name="SpeedUpText" FontSize="12" FontWeight="SemiBold"
                     Foreground="{StaticResource TextBrush}" Margin="0,0,16,0"/>
          <TextBlock x:Name="SpeedDownText" FontSize="12" FontWeight="SemiBold"
                     Foreground="{StaticResource TextBrush}"/>
        </StackPanel>
      </Border>

      <!-- Totals -->
      <Grid Grid.Row="3" Margin="14,4,14,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                Padding="10,8" Margin="0,0,4,0">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock x:Name="TotalSentText" FontSize="18" FontWeight="Bold"
                       Foreground="#FF4DA6FF" HorizontalAlignment="Center"/>
            <TextBlock Text="↑  sent" FontSize="10.5" Foreground="{StaticResource TextDimBrush}"
                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                Padding="10,8" Margin="4,0,0,0">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock x:Name="TotalRecvText" FontSize="18" FontWeight="Bold"
                       Foreground="#FF4ADE80" HorizontalAlignment="Center"/>
            <TextBlock Text="↓  received" FontSize="10.5" Foreground="{StaticResource TextDimBrush}"
                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Sparkline chart (large) -->
      <Border Grid.Row="4" Margin="14,0,14,8" Background="{StaticResource SurfaceBrush}"
              CornerRadius="6" Padding="8,6">
        <ctrl:SparklineControl x:Name="BigSparkline" HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch" Width="NaN" Height="NaN"/>
      </Border>

      <!-- Top destinations -->
      <Border Grid.Row="5" Margin="14,0,14,12" Background="{StaticResource SurfaceBrush}"
              CornerRadius="6" Padding="10,8">
        <StackPanel>
          <TextBlock Text="Top Destinations" FontSize="11" FontWeight="SemiBold"
                     Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,6"/>
          <ItemsControl x:Name="DestList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Key}" FontSize="11.5"
                             Foreground="{StaticResource TextBrush}"
                             TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11"
                             Foreground="{StaticResource TextDimBrush}" Margin="8,0,0,0"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
