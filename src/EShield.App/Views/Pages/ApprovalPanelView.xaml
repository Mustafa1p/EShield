<UserControl x:Class="EShield.Views.Pages.ApprovalPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:EShield.Models">

  <Border Background="{StaticResource BgBrush}"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="0,0,0,1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>    <!-- section 1: pending list -->
        <RowDefinition Height="Auto"/>    <!-- section 2: selected detail -->
      </Grid.RowDefinitions>

      <!-- ══ SECTION 1: Pending apps list ══════════════════════════════════ -->
      <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
        <StackPanel>
          <!-- Header row -->
          <Grid Margin="12,8,12,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="🌐" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center">
                <Run Text="Connections Awaiting Approval ("/>
                <Run Text="{Binding PendingApprovals.Count, Mode=OneWay}"/>
                <Run Text=")"/>
              </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button Content="Allow All" Style="{StaticResource GhostButton}"
                      Padding="8,4" FontSize="11" Margin="0,0,4,0"
                      Command="{Binding ApproveAllCommand}"/>
              <Button Content="Block All" Style="{StaticResource DangerButton}"
                      Padding="8,4" FontSize="11"
                      Command="{Binding BlockAllCommand}"/>
            </StackPanel>
          </Grid>

          <!-- Separator -->
          <TextBlock Text="Connections stay blocked until you allow them. Retry the app or website after approving."
                     TextWrapping="Wrap" Margin="12,0,12,8" FontSize="10.5" Foreground="{StaticResource TextDimBrush}"/>
          <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,0"/>

          <!-- Scrollable list of pending apps (max 260px) -->
          <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding PendingApprovals}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type m:ApprovalRequest}">
                  <StackPanel>
                    <!-- App header row -->
                    <Button Style="{StaticResource ProcessRow}" Tag="{Binding}"
                            Click="AppHeader_Click">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="20"/>   <!-- expand arrow -->
                          <ColumnDefinition Width="32"/>   <!-- icon -->
                          <ColumnDefinition Width="*"/>    <!-- name + bundle -->
                          <ColumnDefinition Width="Auto"/> <!-- badge -->
                        </Grid.ColumnDefinitions>
                        <!-- Expand arrow -->
                        <TextBlock Grid.Column="0" FontSize="10"
                                   Text="{Binding IsExpanded, Converter={StaticResource ExpandArrow}}"
                                   Foreground="{StaticResource TextDimBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <!-- App icon -->
                        <Border Grid.Column="1" Width="28" Height="28" CornerRadius="6"
                                Background="{StaticResource Surface2Brush}" Margin="0,0,8,0"
                                VerticalAlignment="Center">
                          <Image Source="{Binding Process.AppIcon}" Stretch="UniformToFill"
                                 Visibility="{Binding Process.AppIcon, Converter={StaticResource NullVis}}"
                                 RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <!-- Name + bundle -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Process.Name}" FontSize="13" FontWeight="SemiBold"
                                     Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding BundleId}" FontSize="10.5"
                                     Foreground="{StaticResource TextDimBrush}"
                                     TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <!-- Connection count badge -->
                        <Border Grid.Column="3" Background="{StaticResource Surface2Brush}"
                                CornerRadius="10" Padding="6,2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding ConnectionCount}" FontSize="11"
                                     FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}"/>
                        </Border>
                      </Grid>
                    </Button>

                    <!-- Sub-connections (shown when expanded) -->
                    <ItemsControl ItemsSource="{Binding Connections}"
                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolVis}}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:PendingConnection}">
                          <Border x:Name="ConnRow" Background="Transparent"
                                  Padding="52,5,12,5" Cursor="Hand"
                                  MouseEnter="ConnRow_MouseEnter"
                                  MouseLeave="ConnRow_MouseLeave"
                                  MouseLeftButtonDown="ConnRow_Click">
                            <StackPanel>
                              <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding CountryCode, Converter={StaticResource CountryFlag}}" Width="20" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding HostPort}" FontSize="12"
                                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                              </StackPanel>
                              <TextBlock Text="{Binding LocationLine}" FontSize="10.5"
                                         Foreground="{StaticResource TextDimBrush}" Margin="18,1,0,0"/>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>

      <!-- ══ SECTION 2: Selected app detail ════════════════════════════════ -->
      <Border Grid.Row="1"
              Visibility="{Binding SelectedApproval, Converter={StaticResource NullVis}}"
              Background="{StaticResource SurfaceBrush}" Padding="14,10">
        <StackPanel DataContext="{Binding SelectedApproval}">
          <!-- App header -->
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="46"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8"
                    Background="{StaticResource Surface2Brush}" VerticalAlignment="Center">
              <Image Source="{Binding Process.AppIcon}" Stretch="UniformToFill"
                     Visibility="{Binding Process.AppIcon, Converter={StaticResource NullVis}}"
                     RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
              <TextBlock Text="{Binding Process.Name}" FontSize="14" FontWeight="Bold"
                         Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding BundleId}" FontSize="10.5"
                         Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis"
                         Margin="0,2,0,0"/>
            </StackPanel>
          </Grid>

          <!-- Separator -->
          <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,8"/>

          <!-- Detail rows -->
          <TextBlock Text="{Binding Process.SignatureText}" FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="90"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Application" FontSize="11"
                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Process.Name}" FontSize="11"
                       Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="App Path" FontSize="11"
                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Process.ExecutablePath}" FontSize="11"
                       Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="PID" FontSize="11"
                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Process.Pid}" FontSize="11"
                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Requests" FontSize="11"
                       Foreground="{StaticResource TextDimBrush}"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ConnectionCount}" FontSize="11"
                       Foreground="{StaticResource TextBrush}"/>
          </Grid>

          <!-- Separator -->
          <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,6,0,8"/>

          <!-- Action buttons -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource DangerButton}"
                    Command="{Binding DataContext.BlockSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="🖐" Margin="0,0,6,0"/>
                <TextBlock Text="Block this app"/>
              </StackPanel>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource SuccessButton}"
                    Command="{Binding DataContext.ApproveSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="✓" Margin="0,0,6,0"/>
                <TextBlock Text="Allow this app"/>
              </StackPanel>
            </Button>
          </Grid>

          <!-- Keyboard shortcuts hint -->
          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock FontSize="9.5" Foreground="{StaticResource TextDimBrush}">
                <Run Text="Ctrl+Shift+B" FontWeight="SemiBold"/>
                <Run Text="  Block this app"/>
              </TextBlock>
              <TextBlock FontSize="9.5" Foreground="{StaticResource TextDimBrush}" Margin="0,1,0,0">
                <Run Text="Ctrl+Enter" FontWeight="SemiBold"/>
                <Run Text="  Allow this app"/>
              </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock FontSize="9.5" Foreground="{StaticResource TextDimBrush}">
                <Run Text="Ctrl+Shift+A" FontWeight="SemiBold"/>
                <Run Text="  Block all"/>
              </TextBlock>
              <TextBlock FontSize="9.5" Foreground="{StaticResource TextDimBrush}" Margin="0,1,0,0">
                <Run Text="Ctrl+Shift+Enter" FontWeight="SemiBold"/>
                <Run Text="  Allow all"/>
              </TextBlock>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
