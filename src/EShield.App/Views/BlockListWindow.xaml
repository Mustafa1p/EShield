<Window x:Class="EShield.Views.BlockListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Block List — EShield" Width="540" Height="500"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterOwner">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,14">
      <TextBlock Text="Block List" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
      <CheckBox Content="Enable Block List" IsChecked="{Binding IsListEnabled}" Foreground="{StaticResource TextBrush}" Margin="0,8,0,4"/>
      <TextBlock Text="Block one domain, wildcard, IP address, or executable. Separate entries with commas. Enforced by Windows Filtering Platform."
                 FontSize="11.5" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="10">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox Style="{StaticResource DarkTextBox}"
                 Text="{Binding NewRuleInput, UpdateSourceTrigger=PropertyChanged}"
                 ui:ControlHelper.PlaceholderText="Enter domain (e.g. ads.example.com) or app path…">
          <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding AddDomainRuleCommand}"/></TextBox.InputBindings>
        </TextBox>
        <Button Grid.Column="1" Style="{StaticResource DangerButton}" Margin="10,0,0,0"
                Command="{Binding AddDomainRuleCommand}" Content="+ Block"/>
        <Button Grid.Row="1" Style="{StaticResource GhostButton}" Content="Choose app…" HorizontalAlignment="Left" Margin="0,8,0,0" Click="ChooseApp_Click"/>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="2">
      <ItemsControl ItemsSource="{Binding Rules}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Margin="0,3" Padding="10,8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource BlockedDotBrush}" Margin="0,0,10,0">
                  <TextBlock Text="🚫" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                  <TextBlock Text="{Binding DisplayTarget}" FontSize="10.5" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" Background="{StaticResource Surface2Brush}" CornerRadius="5" Padding="6,2" Margin="8,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding TypeLabel}" FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
                </Border>
                <Button Grid.Column="3" Style="{StaticResource GhostButton}" Padding="6,4" FontSize="11"
                        Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" Foreground="{StaticResource BlockedDotBrush}" Content="Remove"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</Window>
